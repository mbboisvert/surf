# Shopify checkout. Leave these blank and the shop still shows the tee, hat,
# and wax, but checkout does not charge.
#
# SHOPIFY_STORE_DOMAIN is the shop host, such as your-store.myshopify.com.
# SHOPIFY_STOREFRONT_ACCESS_TOKEN is a Storefront API access token.
# Each variant is a ProductVariant gid, or the numeric id.

SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_VARIANT_TEE=
SHOPIFY_VARIANT_HAT=
SHOPIFY_VARIANT_WAX=
